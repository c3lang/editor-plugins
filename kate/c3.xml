    <contexts>
      <context attribute="Normal Text" lineEndContext="#stay" name="Normal">
        <DetectSpaces/>
        <!-- comments -->
        <Detect2Chars char="/" char1="/" attribute="Comment" context="Comment"/>
        <Detect2Chars char="/" char1="*" attribute="Comment" context="MultiLineComment" beginRegion="Comment"/>
        <Detect2Chars char="&lt;" char1="*" attribute="Comment" context="Contract" beginRegion="Contract"/>
        <Detect2Chars char="*" char1="&gt;" attribute="Comment" context="#pop" endRegion="Contract"/>
        <DetectChar attribute="Symbol" context="#stay" char="{" beginRegion="Brace1"/>
        <DetectChar attribute="Symbol" context="#stay" char="}" endRegion="Brace1"/>
        <!-- keywords -->
        <keyword attribute="Keyword" context="Function" String="fn"/>
        <keyword attribute="Keyword" context="#stay" String="keywords"/>
        <keyword attribute="Control Flow" context="#stay" String="controlflow"/>
        <keyword attribute="Data Type" context="#stay" String="types"/>
        <keyword attribute="Preprocessor" context="#stay" String="preprocessor"/>
        <keyword attribute="Attribute" context="#stay" String="attributes"/>
        <!-- function calls -->
        <RegExpr String="[A-Za-z0-9_]+(?=\()" attribute="Function" context="#stay"/>
        <!-- inner structs -->
        <RegExpr String="(?&lt;=(bit)?struct )[a-z_][a-zA-Z0-9_]+" attribute="Data Type" context="#stay"/>
        <!-- methods -->
        <DetectChar char="." attribute="Symbol" context="Dot" lookAhead="1"/>
        <!-- module -->
        <RegExpr String="(?&lt;=(module|import) )[a-z0-9_]+" attribute="Standard Suffix" context="#stay"/>
        <IncludeRules context="ModuleMember"/>
        <IncludeRules context="ModuleName"/>
        <!-- user defined types and contants -->
        <RegExpr String="[A-Z_]" attribute="Data Type" context="TypeOrConst"/>
        <!-- numbers -->
        <RegExpr String="0[xX]" attribute="Standard Suffix" context="HexPrefix"/>
        <RegExpr String="0o" attribute="Standard Suffix" context="OctalPrefix"/>
        <RegExpr String="[0-9_]+\.[0-9_]+" attribute="Float" context="FloatSuffixes"/>
        <RegExpr String="[0-9_]+" attribute="Decimal" context="IntSuffixes"/>
        <!-- strings -->
        <DetectChar attribute="String" context="DoubleQuoteString" char="&quot;"/>
        <DetectIdentifier/>
      </context>
      <context attribute="Comment" lineEndContext="#pop" name="Comment"/>
      <context attribute="Comment" lineEndContext="#stay" name="MultiLineComment">
        <DetectSpaces/>
        <Detect2Chars attribute="Comment" context="#pop" char="*" char1="/" endRegion="Comment"/>
      </context>
      <context attribute="String" lineEndContext="#pop" name="DoubleQuoteString">
        <DetectChar context="EscapeChar" char="\" lookAhead="1"/>
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
      </context>
      <context attribute="String Char" lineEndContext="#pop" name="EscapeChar">
        <RegExpr attribute="String Char" context="#pop" String="\\([nrt'&quot;\\]|x[0-9a-fA-F]{2}|u\{[0-9a-fA-F]+\})"/>
        <RegExpr attribute="Error" context="#pop" String="\\(x[0-9a-fA-F]?|u\{[0-9a-fA-F]{0,8}\}?)?"/>
      </context>
      <context name="IntSuffixes" attribute="Standard Suffix" fallthroughContext="#pop" lineEndContext="#pop">
        <RegExpr String="(?i)u?l?l?(?-i)" attribute="Standard Suffix" context="#pop"/>
      </context>
      <context name="FloatSuffixes" attribute="Standard Suffix" fallthroughContext="#pop" lineEndContext="#pop">
        <StringDetect String="f" attribute="Standard Suffix" context="#pop" insensitive="1"/>
        <StringDetect String="d" attribute="Standard Suffix" context="#pop" insensitive="1"/>
        <AnyChar String="fFdD" attribute="Standard Suffix" context="#pop"/>
      </context>
      <context name="HexPrefix" attribute="Normal Text" fallthroughContext="#pop" lineEndContext="#pop">
        <RegExpr String="[0-9a-fA-F_]+" attribute="Hex" context="pop"/>
      </context>
      <context name="OctalPrefix" attribute="Normal Text" fallthroughContext="#pop" lineEndContext="#pop">
        <RegExpr String="[0-7_]+" attribute="Octal" context="pop"/>
      </context>
      <context name="TypeOrConst" attribute="Data Type" fallthroughContext="#pop" lineEndContext="#pop">
        <RegExpr String="[A-Za-z0-9_]+" attribute="Data Type" context="#pop"/>
      </context>
      <!-- func highlighting -->
      <context attribute="Normal Text" lineEndContext="#pop" name="Function">
        <DetectSpaces/>
        <!-- built in types -->
        <keyword attribute="Data Type" context="FindFunctionName" String="types"/>
        <!-- BEGIN namespaces and such -->
        <RegExpr String="[A-Z][A-Za-z0-9_]+" attribute="Data Type" context="#stay"/>
        <RegExpr String="(?&lt;=::)[A-Za-z0-9_]+" attribute="Data Type" context="#stay"/>
        <RegExpr String="[A-Za-z0-9_]+(?=::)" attribute="Standard Suffix" context="#stay"/>
        <!-- END namespaces and such -->
        <IncludeRules context="FindFunctionName" includeAttrib="true"/>
      </context>
      <context attribute="Function" lineEndContext="#pop#pop" name="FindFunctionName">
        <DetectSpaces/>
        <RegExpr String="::|\*|\?|!|\[\]|\.|@" attribute="Symbol" context="#stay"/>
        <AnyChar String="(&lt;" attribute="Normal Text" context="#pop#pop" lookAhead="true"/>
      </context>
      <!-- method highlighting -->
      <context name="Dot" attribute="Normal Text">
        <StringDetect String="..." attribute="Keyword" context="#pop"/>
        <DetectChar char="." attribute="Symbol" context="#pop!Member"/>
      </context>
      <context name="Member" attribute="Normal Text" fallthroughContext="#pop">
        <DetectSpaces attribute="Normal Text"/>
        <RegExpr String="(?&lt;=\.)[A-Za-z0-9_]+(?=\()" attribute="Function" context="#pop"/>
        <RegExpr String="(?&lt;=\.)[A-Za-z0-9_]+" attribute="Data Type" context="#pop"/>
      </context>
      <!-- module highlighting -->
      <context name="ModuleName" attribute="Normal Text">
        <RegExpr String="[A-Za-z0-9_]+(?=::)" attribute="Standard Suffix" context="#pop"/>
      </context>
      <context name="ModuleMember" attribute="Normal Text">
        <RegExpr String="(?&lt;=::)[A-Za-z0-9_]+(?=\()" attribute="Function" context="#pop"/>
        <RegExpr String="(?&lt;=::)[A-Za-z0-9_]+" attribute="Data Type" context="#pop"/>
      </context>
      <!-- contract highlighting -->
      <context name="Contract" attribute="Comment">
        <DetectSpaces/>
        <!-- change the context to "#pop" for full highlighting. -->
        <RegExpr String="@require|@ensure|@param|@return" attribute="Attribute" context="#stay"/>
        <Detect2Chars char="*" char1="&gt;" attribute="Comment" context="#pop" endRegion="Contract"/>
      </context>
    </contexts>
