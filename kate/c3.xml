    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <DetectSpaces/>
        <Detect2Chars char="#" char1="!" column="0" attribute="Comment" context="Comment"/>
        <Detect2Chars char="/" char1="/" attribute="Comment" context="Comment"/>
        <Detect2Chars char="/" char1="*" attribute="Comment" context="MultiLineComment" beginRegion="Comment"/>
        <!-- "[<" (vector) is lexed before "<*", so bool[<*>] is not a doc comment -->
        <Detect2Chars char="[" char1="&lt;" attribute="Symbol" context="#stay"/>
        <Detect2Chars char="&lt;" char1="*" attribute="Documentation" context="Doc" beginRegion="Doc"/>
        <DetectChar char="{" attribute="Symbol" context="#stay" beginRegion="Brace"/>
        <DetectChar char="}" attribute="Symbol" context="#stay" endRegion="Brace"/>

        <keyword String="controlflow" attribute="Control Flow" context="#stay"/>
        <keyword String="keywords" attribute="Keyword" context="#stay"/>
        <keyword String="modulekw" attribute="Keyword" context="ModulePath"/>
        <keyword String="constants" attribute="Constant" context="#stay"/>
        <keyword String="types" attribute="Data Type" context="#stay"/>
        <keyword String="ct_begin" attribute="Compile-time" context="#stay" beginRegion="CT"/>
        <keyword String="ct_end" attribute="Compile-time" context="#stay" endRegion="CT"/>
        <keyword String="ct_keywords" attribute="Compile-time" context="#stay"/>
        <keyword String="attributes" attribute="Attribute" context="#stay"/>

        <!-- prefixed identifiers -->
        <RegExpr String="\$\$[A-Za-z_][A-Za-z0-9_]*" attribute="Builtin" context="#stay"/>
        <RegExpr String="\$_*[A-Z][A-Z0-9_]*[a-z][A-Za-z0-9_]*" attribute="Data Type" context="#stay"/>
        <RegExpr String="\$[A-Za-z_][A-Za-z0-9_]*|#_*[a-z][A-Za-z0-9_]*" attribute="Compile-time Variable" context="#stay"/>
        <RegExpr String="@_*[A-Z][A-Za-z0-9_]*" attribute="Attribute" context="#stay"/>
        <RegExpr String="@_*[a-z][A-Za-z0-9_]*" attribute="Function" context="#stay"/>

        <!-- literals -->
        <RegExpr String="x([&quot;'`])" attribute="Bytes" context="HexBytes"/>
        <RegExpr String="b64([&quot;'`])" attribute="Bytes" context="Base64Bytes"/>
        <DetectChar char="&quot;" attribute="String" context="String"/>
        <DetectChar char="`" attribute="String" context="RawString"/>
        <DetectChar char="'" attribute="Char" context="Char"/>
        <RegExpr String="0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*(?:\.(?!\.)[0-9A-Fa-f_]*)?(?:[pP][+-]?[0-9]+[fFdD]?)?(?:[uU][lL]{0,2}|[lL]{1,2})?(?![A-Za-z0-9_])" attribute="Hex" context="#stay"/>
        <RegExpr String="0[bB][01](?:_?[01])*(?:[uU][lL]{0,2}|[lL]{1,2})?(?![A-Za-z0-9_])" attribute="Binary" context="#stay"/>
        <RegExpr String="0[oO][0-7](?:_?[0-7])*(?:[uU][lL]{0,2}|[lL]{1,2})?(?![A-Za-z0-9_])" attribute="Octal" context="#stay"/>
        <RegExpr String="[0-9](?:_?[0-9])*(?:\.(?!\.)(?:[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9]+)?[fFdD]?|[eE][+-]?[0-9]+[fFdD]?|[fFdD])(?![A-Za-z0-9_])" attribute="Float" context="#stay"/>
        <RegExpr String="[0-9](?:_?[0-9])*(?:[uU][lL]{0,2}|[lL]{1,2})?(?![A-Za-z0-9_])" attribute="Decimal" context="#stay"/>
        <RegExpr String="[0-9][A-Za-z0-9_.]*" attribute="Error" context="#stay"/>

        <!-- plain identifiers -->
        <RegExpr String="_*[a-z][A-Za-z0-9_]*(?=::)" attribute="Module" context="#stay"/>
        <RegExpr String="_*[a-z][A-Za-z0-9_]*(?=\s*\()" attribute="Function" context="#stay"/>
        <RegExpr String="_*[A-Z][A-Z0-9_]*[a-z][A-Za-z0-9_]*" attribute="Data Type" context="#stay"/>
        <RegExpr String="_*[A-Z][A-Z0-9_]*" attribute="Constant" context="#stay"/>
        <DetectIdentifier/>

        <AnyChar String=".:;,=+-*/%&amp;|^~!?&lt;&gt;()[]@#$" attribute="Symbol" context="#stay"/>
      </context>

      <!-- module/import paths: every segment is a module name -->
      <context name="ModulePath" attribute="Normal Text" lineEndContext="#stay" fallthroughContext="#pop">
        <DetectSpaces/>
        <IncludeRules context="CommentStart"/>
        <Detect2Chars char=":" char1=":" attribute="Symbol" context="#stay"/>
        <DetectChar char="," attribute="Symbol" context="#stay"/>
        <keyword String="attributes" attribute="Attribute" context="#stay"/>
        <RegExpr String="@_*[A-Z][A-Za-z0-9_]*" attribute="Attribute" context="#stay"/>
        <RegExpr String="_*[a-z][A-Za-z0-9_]*" attribute="Module" context="#stay"/>
      </context>

      <!-- comments -->
      <context name="CommentStart" attribute="Normal Text" lineEndContext="#stay">
        <Detect2Chars char="/" char1="/" attribute="Comment" context="Comment"/>
        <Detect2Chars char="/" char1="*" attribute="Comment" context="MultiLineComment" beginRegion="Comment"/>
      </context>
      <context name="Comment" attribute="Comment" lineEndContext="#pop">
        <DetectSpaces/>
        <IncludeRules context="##Comments"/>
        <DetectIdentifier/>
      </context>
      <!-- c3c allows nested block comments -->
      <context name="MultiLineComment" attribute="Comment" lineEndContext="#stay">
        <DetectSpaces/>
        <Detect2Chars char="*" char1="/" attribute="Comment" context="#pop" endRegion="Comment"/>
        <Detect2Chars char="/" char1="*" attribute="Comment" context="MultiLineComment" beginRegion="Comment"/>
        <IncludeRules context="##Comments"/>
        <DetectIdentifier/>
      </context>

      <!-- <* doc text, then contract lines *> -->
      <context name="Doc" attribute="Documentation" lineEndContext="#stay">
        <DetectSpaces/>
        <Detect2Chars char="*" char1="&gt;" attribute="Documentation" context="#pop" endRegion="Doc"/>
        <RegExpr String="@param\b" firstNonSpace="true" attribute="Contract" context="ContractParam"/>
        <RegExpr String="@_*[a-z][A-Za-z0-9_]*\??" firstNonSpace="true" attribute="Contract" context="ContractCode"/>
        <IncludeRules context="##Comments"/>
        <DetectIdentifier/>
      </context>
      <context name="ContractParam" attribute="Normal Text" lineEndContext="#pop" fallthroughContext="#pop!ContractCode">
        <DetectSpaces/>
        <RegExpr String="\[&amp;?(?:in|out|inout)\]" attribute="Contract" context="#stay"/>
        <RegExpr String="[$#]?[A-Za-z_][A-Za-z0-9_]*|\.\.\." attribute="Parameter" context="#pop!ContractCode"/>
      </context>
      <context name="ContractCode" attribute="Normal Text" lineEndContext="#pop">
        <Detect2Chars char="*" char1="&gt;" lookAhead="true" context="#pop"/>
        <IncludeRules context="Normal"/>
      </context>

      <!-- strings -->
      <context name="String" attribute="String" lineEndContext="#pop">
        <DetectChar char="\" lookAhead="true" context="Escape"/>
        <DetectChar char="&quot;" attribute="String" context="#pop"/>
      </context>
      <context name="Char" attribute="Char" lineEndContext="#pop">
        <DetectChar char="\" lookAhead="true" context="Escape"/>
        <DetectChar char="'" attribute="Char" context="#pop"/>
      </context>
      <context name="Escape" attribute="String Char" lineEndContext="#pop">
        <RegExpr String="\\(?:[abefnrtv'&quot;\\0]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})" attribute="String Char" context="#pop"/>
        <RegExpr String="\\.?" attribute="Error" context="#pop"/>
      </context>
      <context name="RawString" attribute="String" lineEndContext="#stay">
        <Detect2Chars char="`" char1="`" attribute="String Char" context="#stay"/>
        <DetectChar char="`" attribute="String" context="#pop"/>
      </context>
      <context name="HexBytes" attribute="Bytes" lineEndContext="#stay" dynamic="true">
        <DetectSpaces/>
        <DetectChar char="1" dynamic="true" attribute="Bytes" context="#pop"/>
        <RegExpr String="[0-9A-Fa-f]+" attribute="Bytes" context="#stay"/>
        <RegExpr String="." attribute="Error" context="#stay"/>
      </context>
      <context name="Base64Bytes" attribute="Bytes" lineEndContext="#stay" dynamic="true">
        <DetectSpaces/>
        <DetectChar char="1" dynamic="true" attribute="Bytes" context="#pop"/>
        <RegExpr String="[A-Za-z0-9+/]+={0,2}" attribute="Bytes" context="#stay"/>
        <RegExpr String="." attribute="Error" context="#stay"/>
      </context>
    </contexts>

    <itemDatas>
      <itemData name="Normal Text"           defStyleNum="dsNormal"        spellChecking="false"/>
      <itemData name="Keyword"               defStyleNum="dsKeyword"       spellChecking="false"/>
